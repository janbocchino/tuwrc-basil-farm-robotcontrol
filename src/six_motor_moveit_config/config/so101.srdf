<?xml version="1.0" encoding="utf-8"?>
<robot name="so101_rail">
  <group name="arm">
    <chain base_link="rail_link" tip_link="tcp" />
  </group>
  <group name="gripper">
    <joint name="6" />
  </group>
  <group name="so101_with_gripper">
    <group name="arm" />
    <group name="gripper" />
  </group>

  <group_state name="home" group="arm">
    <joint name="rail_joint" value="0.0" />
    <joint name="1" value="0.0" />
    <joint name="2" value="0.0" />
    <joint name="3" value="0.0" />
    <joint name="4" value="0.0" />
    <joint name="5" value="0.0" />
  </group_state>
  <group_state name="home" group="gripper">
    <joint name="6" value="0.0" />
  </group_state>
  <group_state name="small_test" group="so101_with_gripper">
    <joint name="rail_joint" value="0.0" />
    <joint name="1" value="0.2" />
    <joint name="2" value="0.2" />
    <joint name="3" value="-0.2" />
    <joint name="4" value="0.15" />
    <joint name="5" value="0.0" />
    <joint name="6" value="0.2" />
  </group_state>
  <group_state name="pose1" group="so101_with_gripper">
    <joint name="rail_joint" value="0.0" />
    <joint name="1" value="-0.36815539" />
    <joint name="2" value="-0.17794177" />
    <joint name="3" value="0.41264083" />
    <joint name="4" value="-0.05062137" />
    <joint name="5" value="-1.80089344" />
    <joint name="6" value="1.18730113" />
  </group_state>
  <group_state name="pose2" group="so101_with_gripper">
    <joint name="rail_joint" value="0.0" />
    <joint name="1" value="-1.26706813" />
    <joint name="2" value="-0.93572828" />
    <joint name="3" value="-0.81607778" />
    <joint name="4" value="-0.29145635" />
    <joint name="5" value="1.34990309" />
    <joint name="6" value="0.07823302" />
  </group_state>
  <group_state name="pose3" group="so101_with_gripper">
    <joint name="rail_joint" value="0.0" />
    <joint name="1" value="-0.12885439" />
    <joint name="2" value="-0.92805838" />
    <joint name="3" value="-1.32996134" />
    <joint name="4" value="-1.27627202" />
    <joint name="5" value="-0.21168935" />
    <joint name="6" value="1.71038858" />
  </group_state>

  <disable_collisions link1="world" link2="rail_link" reason="Adjacent" />
  <disable_collisions link1="rail_link" link2="carriage_link" reason="Adjacent" />
  <disable_collisions link1="rail_link" link2="base" reason="Never" />
  <disable_collisions link1="carriage_link" link2="base" reason="Adjacent" />
  <disable_collisions link1="carriage_link" link2="shoulder" reason="Never" />
  <disable_collisions link1="base" link2="shoulder" reason="Adjacent" />
  <disable_collisions link1="shoulder" link2="upper_arm" reason="Adjacent" />
  <disable_collisions link1="upper_arm" link2="lower_arm" reason="Adjacent" />
  <disable_collisions link1="lower_arm" link2="wrist" reason="Adjacent" />
  <disable_collisions link1="wrist" link2="gripper" reason="Adjacent" />
  <disable_collisions link1="gripper" link2="jaw" reason="Adjacent" />
</robot>