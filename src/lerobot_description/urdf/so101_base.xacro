			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/base_so101_v2.stl" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<collision>
			<origin xyz="0.0207909 0.0221255 0.0300817" rpy="1.5708 -0 0" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/base_so101_v2.stl" />
			</geometry>
		</collision>
		<!-- Part sts3215_03a_v1 -->
		<visual>
			<origin xyz="0.0207909 -0.0105745 0.0761817" rpy="-2.20282e-15 2.77556e-17 -1.5708" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/sts3215_03a_v1.stl" />
			</geometry>
			<material name="sts3215" />
		</visual>
		<collision>
			<origin xyz="0.0207909 -0.0105745 0.0761817" rpy="-2.20282e-15 2.77556e-17 -1.5708" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/sts3215_03a_v1.stl" />
			</geometry>
		</collision>
		<!-- Part waveshare_mounting_plate_so101_v2 -->
		<visual>
			<origin xyz="0.0205915 0.0467435 0.0798817" rpy="1.5708 -1.21716e-14 2.33147e-15" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/waveshare_mounting_plate_so101_v2.stl" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<collision>
			<origin xyz="0.0205915 0.0467435 0.0798817" rpy="1.5708 -1.21716e-14 2.33147e-15" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/waveshare_mounting_plate_so101_v2.stl" />
			</geometry>
		</collision>
	</link>

	<!-- Link shoulder -->
	<link name="shoulder">
		<inertial>
			<origin xyz="-0.0307604 -1.66727e-05 -0.0252713" rpy="0 0 0" />
			<mass value="0.100006" />
			<inertia ixx="8.3759e-05" ixy="7.55525e-08" ixz="-1.16342e-06" iyy="8.10403e-05"
				iyz="1.54663e-07" izz="2.39783e-05" />
		</inertial>
		<!-- Part sts3215_03a_v1_2 -->
		<visual>
			<origin xyz="-0.0303992 0.000422241 -0.0417" rpy="1.5708 1.5708 0" />
