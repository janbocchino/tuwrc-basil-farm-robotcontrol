			<origin xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0" />
			<mass value="0.012" />
			<inertia ixx="6.61427e-06" ixy="-3.19807e-07" ixz="-5.90717e-09" iyy="1.89032e-06"
