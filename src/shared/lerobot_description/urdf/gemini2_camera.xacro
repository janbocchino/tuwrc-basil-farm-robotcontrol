<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Geometric model for an Orbbec Gemini 2.

    This defines only the robot-side camera_link. The Orbbec driver owns the
    calibrated color, depth, IR and optical frames below camera_link.
  -->
  <xacro:macro name="gemini2_camera" params="parent xyz rpy">
    <link name="camera_link">
      <visual>
        <geometry>
          <!-- Body depth x width x height (Gemini 2: 90 x 25 x 30 mm). -->
          <box size="0.025 0.090 0.030" />
        </geometry>
        <material name="gemini2_body">
          <color rgba="0.08 0.08 0.10 1.0" />
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.025 0.090 0.030" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.098" />
        <inertia
          ixx="0.000068" ixy="0.0" ixz="0.0"
          iyy="0.000012" iyz="0.0"
          izz="0.000071" />
      </inertial>
    </link>

    <joint name="gripper_to_camera" type="fixed">
      <parent link="${parent}" />
      <child link="camera_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>
  </xacro:macro>
</robot>
