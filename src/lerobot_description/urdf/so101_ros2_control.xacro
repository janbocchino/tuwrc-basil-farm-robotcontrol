<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name="RobotSystem" type="system">
        <!-- ros2_control Gazebo -->
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <!-- Optional Gazebo path only; MVP uses mock/real action servers instead. -->
        <joint name="rail_joint">
            <command_interface name="position">
                <param name="min">-0.5</param>
                <param name="max">0.5</param>
            </command_interface>
            <state_interface name="position" />
        </joint>

        <joint name="1">
            <command_interface name="position">
                <param name="min">-2.06780610</param>
                <param name="max">2.06780610</param>
            </command_interface>
            <state_interface name="position" />
        </joint>

        <joint name="2">
            <command_interface name="position">
                <param name="min">-1.85304879</param>
                <param name="max">1.85304879</param>
            </command_interface>
            <state_interface name="position" />
        </joint>

        <joint name="3">
            <command_interface name="position">
                <param name="min">-1.68737887</param>
                <param name="max">1.68891285</param>
            </command_interface>
            <state_interface name="position" />
        </joint>

        <joint name="4">
            <command_interface name="position">
                <param name="min">-1.80702937</param>
                <param name="max">1.80702937</param>
            </command_interface>
            <state_interface name="position" />
        </joint>
        <joint name="5">
            <command_interface name="position">
                <param name="min">-2.89308777</param>
                <param name="max">2.89308777</param>
            </command_interface>
            <state_interface name="position" />
        </joint>

        <joint name="6">
            <command_interface name="position">
                <param name="min">-0.18561168</param>
                <param name="max">2.03252454</param>
            </command_interface>
            <state_interface name="position" />
        </joint>
    </ros2_control>

</robot>
