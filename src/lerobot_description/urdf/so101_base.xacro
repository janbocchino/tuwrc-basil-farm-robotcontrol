<?xml version="1.0"?>

<!--
  This file is based on the SO-ARM100 model from:
  https://github.com/TheRobotStudio/SO-ARM100
  and has been modified accordingly.
-->

<robot name="so101_rail" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!--
		Rail geometry is provisional until the assembled CAD model is available.
		All mounting values are arguments so the measured SO-101 chain below never
		needs to be changed when the rail alignment is corrected.
	-->
	<xacro:arg name="rail_lower" default="-0.5" />
	<xacro:arg name="rail_upper" default="0.5" />
	<xacro:arg name="rail_velocity" default="1.0" />
	<xacro:arg name="rail_mount_x" default="-0.03" />
	<xacro:arg name="rail_mount_y" default="0.0" />
	<xacro:arg name="rail_mount_z" default="-0.07" />
	<xacro:arg name="rail_mount_roll" default="0.0" />
	<xacro:arg name="rail_mount_pitch" default="0.0" />
	<xacro:arg name="rail_mount_yaw" default="0.0" />

	<!-- Fixed world and provisional X rail. -->
	<link name="world" />

	<link name="rail_link">
		<visual>
			<origin xyz="-0.5 0 -0.085" rpy="1.5708 0 1.5708" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/rail/rail.stl"
					scale="0.0001 0.0001 0.0001" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<visual>
			<origin xyz="-0.5 -0.090 -0.085" rpy="1.5708 0 1.5708" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/rail/rail.stl"
					scale="0.0001 0.0001 0.0001" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<mass value="1.0" />
			<inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
		</inertial>
	</link>

	<joint name="world_to_rail" type="fixed">
		<parent link="world" />
		<child link="rail_link" />
		<origin xyz="0 0 0.085" rpy="0 0 0" />
	</joint>

	<link name="carriage_link">
		<visual>
			<origin xyz="0.070 -0.070 0" rpy="0 3.14159 0" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/rail/plate.stl"
					scale="0.0001 0.0001 0.0001" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<mass value="0.5" />
			<inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
		</inertial>
	</link>

	<joint name="rail_joint" type="prismatic">
		<parent link="rail_link" />
		<child link="carriage_link" />
		<origin xyz="0 0 0" rpy="0 0 0" />
		<axis xyz="1 0 0" />
		<limit effort="50" velocity="$(arg rail_velocity)"
			lower="$(arg rail_lower)" upper="$(arg rail_upper)" />
	</joint>

	<transmission name="rail_joint_trans">
		<type>transmission_interface/SimpleTransmission</type>
		<joint name="rail_joint">
			<hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
		</joint>
		<actuator name="motor_rail">
			<hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
			<mechanicalReduction>1</mechanicalReduction>
		</actuator>
	</transmission>

	<joint name="base_joint" type="fixed">
		<parent link="carriage_link" />
		<child link="base" />
		<origin
			xyz="$(arg rail_mount_x) $(arg rail_mount_y) $(arg rail_mount_z)"
			rpy="$(arg rail_mount_roll) $(arg rail_mount_pitch) $(arg rail_mount_yaw)" />
	</joint>

	<!-- Materials -->
	<material name="3d_printed">
		<color rgba="1.0 0.82 0.12 1.0" />
	</material>
	<material name="sts3215">
		<color rgba="0.1 0.1 0.1 1.0" />
	</material>

	<!-- Link base -->
	<link name="base">
		<inertial>
			<origin xyz="0.020739 0.00204287 0.065966" rpy="0 0 0" />
			<mass value="0.147" />
			<inertia ixx="0.000136117" ixy="4.59787e-07" ixz="9.75275e-08" iyy="0.000114686"
				iyz="-4.97151e-06" izz="0.000130364" />
		</inertial>
		<!-- Part base_motor_holder_so101_v1 -->
		<visual>
			<origin xyz="0.0206915 0.0221255 0.0300817" rpy="1.5708 -1.23909e-16 2.33147e-15" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/base_motor_holder_so101_v1.stl" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<collision>
			<origin xyz="0.0206915 0.0221255 0.0300817" rpy="1.5708 -1.23909e-16 2.33147e-15" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/base_motor_holder_so101_v1.stl" />
			</geometry>
		</collision>
