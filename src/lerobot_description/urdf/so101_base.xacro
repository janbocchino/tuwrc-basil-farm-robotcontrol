		<visual>
			<origin xyz="-0.0675992 -0.000177759 0.0158499" rpy="1.5708 -1.5708 0" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/motor_holder_so101_base_v1.stl" />
			</geometry>
